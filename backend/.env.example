LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional NyayaBot read-aloud voice: Shunya Labs Radiance "Sarita".
# Keep this secret on the backend; without it, browser speech is used.
SHUNYALABS_API_KEY=

# Evidence OCR (scanned PDF pages and images only). Leave blank to disable OCR;
# digital PDFs, DOCX and text files are still extracted directly.
OCR_SPACE_API_KEY=

# Optional tuning. Recent messages are combined with the compact case profile.
LLM_RECENT_MESSAGE_LIMIT=8
LLM_TIMEOUT_SECONDS=30
# Longest Groq retry-after (seconds, 0-120) honoured before one retry. 60 covers
# the free tier's per-minute token window; set 0 to always fall back at once.
GROQ_RATE_LIMIT_MAX_RETRY_WAIT_SECONDS=60

# Authentication uses a random opaque token in a revocable server-side session.
# Keep false for local HTTP. Set true whenever the API is served over HTTPS.
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# For different-site HTTPS frontends, use Secure=true and SameSite=none.
# AUTH_COOKIE_DOMAIN=.example.com

# Exact credentialed frontend origins, comma-separated. Never use * here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. The default is the stable backend/nyayasahay.db path.
# DATABASE_URL=sqlite:///./nyayasahay.db
OCR_SPACE_API_KEY=

# Fill on Portal (browser extension). Development only: serves a local test form
# shaped like the cyber-crime portal at /api/v1/autofill/test-form.
# AUTOFILL_TEST_FORM=1
# AUTOFILL_SESSION_TTL_MINUTES=30
